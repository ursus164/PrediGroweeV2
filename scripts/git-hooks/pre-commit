#!/bin/bash

# Git pre-commit hook - comprehensive security check
# ZAWSZE SKANUJE CAŁE REPO (nie tylko zmienione pliki)
# Kopiuj do: .git/hooks/pre-commit
# lub użyj: ln -s ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit

echo "Running pre-commit security checks (full repository scan)..."

# 1. Sprawdzenie czy nie commitujemy sekretów - CAŁE REPO
echo "Checking for secrets in all files..."
# Pattern: password = "hardcoded_value" (with quotes) - exclude env var reads
if grep -rI "password.*=.*['\"].*['\"]" . --exclude-dir=.git --exclude-dir=node_modules 2>/dev/null | grep -v "POSTGRES_PASSWORD" | grep -v "os.Getenv" | grep -v "process.env"; then
    echo "❌ ERROR: Possible hardcoded password detected!"
    echo "Please remove hardcoded secrets before committing."
    exit 1
fi

# Pattern: api_key = "hardcoded_value" (with quotes) - exclude env var reads
if grep -rI "api[_-]?key.*=.*['\"].*['\"]" . --exclude-dir=.git --exclude-dir=node_modules 2>/dev/null | grep -v "os.Getenv" | grep -v "process.env"; then
    echo "❌ ERROR: Possible hardcoded API key detected!"
    exit 1
fi

# 2. Sprawdzenie czy nie commitujemy dużych plików - STAGED FILES
echo "Checking staged file sizes..."
CHANGED_FILES=$(git diff --cached --name-only)
for file in $CHANGED_FILES; do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file")
        if [ $size -gt 1048576 ]; then  # 1MB
            echo "❌ ERROR: File $file is larger than 1MB ($size bytes)"
            echo "Large files should not be committed to git"
            exit 1
        fi
    fi
done

# 3. Sprawdzenie Dockerfile - WSZYSTKIE
echo "Checking all Dockerfiles..."
if command -v hadolint &> /dev/null; then
    echo "  Running hadolint on all Dockerfiles..."
    for service in auth quiz stats images admin; do
        if [ -f "$service/Dockerfile" ]; then
            hadolint_output=$(hadolint --failure-threshold style "$service/Dockerfile" 2>&1)
            if [ $? -ne 0 ]; then
                echo "❌ Hadolint found issues in $service/Dockerfile:"
                echo "$hadolint_output"
                exit 1
            fi
        fi
    done
    echo "  ✓ Hadolint passed"
else
    # Fallback - kilka prostych checkow
    echo "Hadolint not installed, running basic checks..."

    if grep -r "FROM.*:latest" */Dockerfile 2>/dev/null; then
        echo "WARNING: Using :latest tag in Dockerfile is not recommended"
    fi

    for service in auth quiz stats images admin; do
        if [ -f "$service/Dockerfile" ]; then
            if ! grep -q "^USER" "$service/Dockerfile"; then
                echo "WARNING: $service/Dockerfile doesn't specify USER (might run as root)"
            fi
        fi
    done
fi

# 4. Sprawdzenie trailing whitespace - STAGED FILES
echo "Checking for trailing whitespace in staged files..."
if git diff --cached --check; then
    echo "  ✓ No trailing whitespace"
else
    echo "❌ ERROR: Trailing whitespace found!"
    echo "Fix with: git diff --cached --check"
    exit 1
fi

# 5. Sprawdzenie merge conflicts - STAGED FILES
echo "Checking for merge conflicts in staged files..."
if git diff --cached | grep -n "^<<<<<<< \|^=======$\|^>>>>>>> " 2>/dev/null; then
    echo "❌ ERROR: Merge conflict markers found!"
    exit 1
fi

# 6. Sprawdzenie Go files - WSZYSTKIE SERWISY
echo "Checking all Go services..."

# Go fmt
echo "  Running go fmt on all services..."
go fmt ./... > /dev/null 2>&1

    # Go vet - SCAN ALL SERVICES (not just changed)
    echo "  Running go vet on all services..."
    for service in auth quiz stats images admin; do
        if [ -d "$service" ]; then
            VET_OUTPUT=$(cd $service && go vet ./... 2>&1)
            if [ $? -ne 0 ]; then
                echo "❌ go vet failed for $service:"
                echo "$VET_OUTPUT"
                exit 1
            fi
        fi
    done

    # golangci-lint - SCAN ALL SERVICES (not just changed)
    if command -v golangci-lint &> /dev/null; then
        echo "  Running golangci-lint on all services..."
        for service in auth quiz stats images admin; do
            if [ -d "$service" ]; then
                LINT_OUTPUT=$(cd $service && golangci-lint run --timeout=5m 2>&1)
                if [ $? -ne 0 ]; then
                    echo "❌ golangci-lint issues in $service:"
                    echo "$LINT_OUTPUT" | head -50
                    exit 1
                fi
            fi
        done
    fi

    # staticcheck - SCAN ALL SERVICES (not just changed)
    if command -v staticcheck &> /dev/null; then
        echo "  Running staticcheck on all services..."
        for service in auth quiz stats images admin; do
            if [ -d "$service" ]; then
                STATIC_OUTPUT=$(cd $service && staticcheck -checks all ./... 2>&1)
                if [ $? -ne 0 ]; then
                    echo "❌ staticcheck issues in $service:"
                    echo "$STATIC_OUTPUT" | head -50
                    exit 1
                fi
            fi
        done
    fi

    # gosec - SCAN ALL SERVICES (not just changed)
    if command -v gosec &> /dev/null; then
        echo "  Running gosec (security scanner) on all services..."
        for service in auth quiz stats images admin; do
            if [ -d "$service" ]; then
                GOSEC_OUTPUT=$(cd $service && gosec -quiet ./... 2>&1)
                if [ $? -ne 0 ]; then
                    echo "❌ Security issues found by gosec in $service:"
                    echo "$GOSEC_OUTPUT" | head -50
                    exit 1
                fi
            fi
        done
    fi

    # Go tests - SCAN ALL SERVICES (not just changed)
    echo "  Running go test on all services..."
    for service in auth quiz stats images admin; do
        if [ -d "$service" ]; then
            echo "    Testing $service..."
            TEST_OUTPUT=$(cd $service && go test ./... -short -timeout=30s 2>&1)
            if [ $? -ne 0 ]; then
                echo "❌ Tests failed for $service:"
                echo "$TEST_OUTPUT"
                exit 1
            fi
        fi
    done

    # govulncheck - SCAN ALL SERVICES (not just changed)
    if command -v govulncheck &> /dev/null; then
        echo "  Running govulncheck on all services..."
        for service in auth quiz stats images admin; do
            if [ -d "$service" ]; then
                VULN_OUTPUT=$(cd $service && govulncheck ./... 2>&1)
                VULN_EXIT=$?
                if [ $VULN_EXIT -eq 3 ]; then
                    echo "❌ CRITICAL vulnerabilities found in $service:"
                    echo "$VULN_OUTPUT"
                    echo ""
                    echo "This will FAIL in CI - fix before pushing!"
                    exit 1
                elif [ $VULN_EXIT -ne 0 ]; then
                    echo "⚠️  govulncheck issues in $service (exit code: $VULN_EXIT):"
                    echo "$VULN_OUTPUT" | head -30
                fi
            fi
        done
    fi

# 7. Sprawdzenie package.json/package-lock.json - ZAWSZE
if [ -f "../PrediGroweeV2-UI/package.json" ]; then
    echo "Checking frontend (PrediGroweeV2-UI)..."

    cd ../PrediGroweeV2-UI

    # npm audit
    echo "  Running npm audit..."
    npm audit --audit-level=high 2>&1 | head -20 || echo "  ⚠️  npm audit issues found"

    # prettier (jeśli dostępne)
    if command -v prettier &> /dev/null; then
        echo "  Running prettier check..."
        npx prettier --check "src/**/*.{ts,tsx,js,jsx}" 2>&1 | head -20 || {
            echo "  ⚠️  Prettier formatting issues found"
            echo "    Run: prettier --write <files>"
        }
    fi

    cd ../PrediGroweeV2
fi

# 8. Sprawdzenie YAML files - WSZYSTKIE
echo "Checking all YAML files..."
if command -v yamllint &> /dev/null; then
    find . -name "*.yml" -o -name "*.yaml" | grep -v node_modules | grep -v .git | xargs yamllint 2>&1 | head -20 || {
        echo "  ⚠️  YAML linting issues (non-blocking)"
    }
fi

echo ""
echo "✅ Pre-commit checks passed!"
exit 0
