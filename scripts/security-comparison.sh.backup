#!/bin/bash

# Security Scan Script
# Skanuje zabezpieczenia bieżącego brancha
# Używa: CIS Docker Benchmark + OWASP ZAP

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
REPORT_DIR="$PROJECT_ROOT/security-comparison-report"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Pobierz nazwę bieżącego brancha
CURRENT_BRANCH=$(git branch --show-current)

echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║   SECURITY SCAN FOR BRANCH: ${CURRENT_BRANCH}${NC}"
echo -e "${BLUE}║   CIS Docker Benchmark + OWASP ZAP                       ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""

# Przygotowanie katalogu na raporty
mkdir -p "$REPORT_DIR"
BRANCH_DIR="$REPORT_DIR/${CURRENT_BRANCH}_$TIMESTAMP"
mkdir -p "$BRANCH_DIR"

# ============================================================================
# FUNKCJA: Oblicz wynik z CIS Docker Benchmark
# ============================================================================
calculate_cis_score() {
    local report_file=$1
    local pass=$(grep -c "\[PASS\]" "$report_file" 2>/dev/null || echo 0)
    local warn=$(grep -c "\[WARN\]" "$report_file" 2>/dev/null || echo 0)
    local total=$((pass + warn))
    
    if [ $total -gt 0 ]; then
        echo $((pass * 100 / total))
    else
        echo 0
    fi
}

# ============================================================================
# FUNKCJA: Oblicz wynik z OWASP ZAP
# ============================================================================
calculate_zap_score() {
    local report_file=$1
    local high=$(grep -c '"risk": "High"' "$report_file" 2>/dev/null || echo 0)
    local medium=$(grep -c '"risk": "Medium"' "$report_file" 2>/dev/null || echo 0)
    local low=$(grep -c '"risk": "Low"' "$report_file" 2>/dev/null || echo 0)
    
    # Bazowy wynik 100, odejmuj punkty
    local score=$((100 - (high * 15) - (medium * 5) - (low * 1)))
    [ $score -lt 0 ] && score=0
    echo $score
}

# ============================================================================
# TESTY BEZPIECZEŃSTWA
# ============================================================================

test_branch() {
    local branch=$1
    local report_dir=$2
    
    echo -e "\n${BLUE}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}Testing branch: $branch${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}\n"
    
    # Checkout branch
    cd "$PROJECT_ROOT"
    git checkout "$branch" -q
    
    # ========================================================================
    # PRZYGOTOWANIE: Zbuduj i uruchom aplikację
    # ========================================================================
    echo -e "\n${YELLOW}[Setup] Building and starting application${NC}"
    
    # Zbuduj obrazy
    echo "Building Docker images..."
    docker-compose build 2>&1 | grep -E "(Building|Successfully)" || true
    
    # Uruchom aplikację w tle
    echo "Starting application stack..."
    docker-compose up -d 2>&1 | grep -E "(Creating|Started)" || true
    
    # Poczekaj aż aplikacja będzie gotowa
    echo "Waiting for application to be ready..."
    local max_wait=120
    local elapsed=0
    local ready=false
    
    while [ $elapsed -lt $max_wait ]; do
        # Sprawdź czy nginx odpowiada (404 lub 200 to OK)
        local http_code=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8080 2>/dev/null || echo "000")
        if [ "$http_code" != "000" ] && [ "$http_code" != "502" ] && [ "$http_code" != "503" ]; then
            ready=true
            echo "✓ Application ready after ${elapsed}s (HTTP $http_code)"
            break
        fi
        sleep 5
        elapsed=$((elapsed + 5))
        [ $((elapsed % 20)) -eq 0 ] && echo "  Waiting... ${elapsed}s/${max_wait}s (HTTP $http_code)"
    done
    
    if [ "$ready" != true ]; then
        echo "ERROR: Application not responding after ${max_wait}s"
        docker-compose ps
        # Kontynuuj mimo błędu - uruchom testy na uruchomionych kontenerach
    fi
    
    # ========================================================================
    # TEST 1: CIS Docker Benchmark (Docker Bench Security)
    # ========================================================================
    echo -e "\n${YELLOW}[1/3] CIS Docker Benchmark${NC}"
    
    if command -v docker &> /dev/null; then
        # Pobierz docker-bench-security jeśli nie istnieje
        local bench_dir="$HOME/.docker-bench-security"
        if [ ! -d "$bench_dir" ]; then
            echo "Downloading Docker Bench Security..."
            git clone https://github.com/docker/docker-bench-security.git "$bench_dir" -q
        fi
        
        # Uruchom CIS Docker Benchmark (usuń kody kolorów dla czytelności)
        echo "Running CIS Docker Benchmark tests..."
        cd "$bench_dir"
        sh docker-bench-security.sh 2>&1 | sed 's/\x1b\[[0-9;]*m//g' > "$report_dir/cis-docker-benchmark.txt" || true
        cd "$PROJECT_ROOT"
    else
        echo "ERROR: Docker not available" > "$report_dir/cis-docker-benchmark.txt"
    fi
    
    # ========================================================================
    # TEST 2: OWASP ZAP Baseline Scan
    # ========================================================================
    echo -e "\n${YELLOW}[2/3] OWASP ZAP Baseline Scan${NC}"
    
    # Sprawdź czy aplikacja odpowiada
    if [ "$ready" = true ]; then
        echo "Application is running, starting OWASP ZAP scan..."
        
        # Ustaw odpowiednie uprawnienia dla ZAP (kontener działa jako użytkownik zap uid=1000)
        chmod 777 "$report_dir"
        
        # Uruchom OWASP ZAP baseline scan w kontenerze
        docker run --rm --network host \
            -v "$report_dir":/zap/wrk/:rw \
            -u zap \
            -t ghcr.io/zaproxy/zaproxy:stable \
            zap-baseline.py \
            -t http://localhost:8080 \
            -r owasp-zap-report.html \
            -w owasp-zap-report.md \
            -J owasp-zap-report.json \
            > "$report_dir/owasp-zap.txt" 2>&1 || true
        
        # Przywróć normalne uprawnienia
        chmod 755 "$report_dir"
    else
        echo "ERROR: Application not responding after ${max_wait}s" > "$report_dir/owasp-zap.txt"
        echo "Checking container status..." >> "$report_dir/owasp-zap.txt"
        docker-compose ps >> "$report_dir/owasp-zap.txt" 2>&1
    fi
    
    # Zatrzymaj aplikację
    echo "Stopping application..."
    docker-compose down -v 2>&1 | grep -E "(Stopping|Removing)" || true
    
    # ========================================================================
    # TEST 3: Custom Security Checks
    # ========================================================================
    echo -e "\n${YELLOW}[3/3] Custom Security Configuration Checks${NC}"
    
    {
        echo "=== Custom Security Configuration Analysis ==="
        
        # Check security hardening
        echo -e "\n[1] Security Hardening Configuration"
        local cap_drop=0
        local security_opt=0
        local read_only=0
        local resources=0
        local tmpfs=0
        
        [ -f "docker-compose.yml" ] && cap_drop=$((cap_drop + $(grep -c 'cap_drop:' docker-compose.yml 2>/dev/null || echo 0)))
        [ -f "docker-compose.prod.yml" ] && cap_drop=$((cap_drop + $(grep -c 'cap_drop:' docker-compose.prod.yml 2>/dev/null || echo 0)))
        
        [ -f "docker-compose.yml" ] && security_opt=$((security_opt + $(grep -c 'security_opt:' docker-compose.yml 2>/dev/null || echo 0)))
        [ -f "docker-compose.prod.yml" ] && security_opt=$((security_opt + $(grep -c 'security_opt:' docker-compose.prod.yml 2>/dev/null || echo 0)))
        
        [ -f "docker-compose.yml" ] && read_only=$((read_only + $(grep -c 'read_only:' docker-compose.yml 2>/dev/null || echo 0)))
        [ -f "docker-compose.prod.yml" ] && read_only=$((read_only + $(grep -c 'read_only:' docker-compose.prod.yml 2>/dev/null || echo 0)))
        
        [ -f "docker-compose.yml" ] && resources=$((resources + $(grep -c 'resources:' docker-compose.yml 2>/dev/null || echo 0)))
        [ -f "docker-compose.prod.yml" ] && resources=$((resources + $(grep -c 'resources:' docker-compose.prod.yml 2>/dev/null || echo 0)))
        
        [ -f "docker-compose.yml" ] && tmpfs=$((tmpfs + $(grep -c 'tmpfs:' docker-compose.yml 2>/dev/null || echo 0)))
        [ -f "docker-compose.prod.yml" ] && tmpfs=$((tmpfs + $(grep -c 'tmpfs:' docker-compose.prod.yml 2>/dev/null || echo 0)))
        
        echo "  cap_drop: $cap_drop instances"
        echo "  security_opt: $security_opt instances"
        echo "  read_only: $read_only instances"
        echo "  resource limits: $resources instances"
        echo "  tmpfs: $tmpfs instances"
        
        local hardening_score=$((cap_drop + security_opt + read_only + resources + tmpfs))
        if [ $hardening_score -ge 25 ]; then
            echo "  PASS: Comprehensive hardening ($hardening_score/25)"
        elif [ $hardening_score -ge 15 ]; then
            echo "  WARN: Partial hardening ($hardening_score/25)"
        else
            echo "  FAIL: Insufficient hardening ($hardening_score/25)"
        fi
        
        # Check non-root users
        echo -e "\n[2] Non-root User Configuration"
        local user_count=0
        for service in auth quiz stats images admin; do
            if grep -q "USER " "$service/Dockerfile" 2>/dev/null; then
                user_count=$((user_count + 1))
            fi
        done
        
        if grep -q "user nginx" nginx.conf 2>/dev/null; then
            user_count=$((user_count + 1))
        fi
        
        echo "  Non-root users configured: $user_count/6"
        if [ $user_count -eq 6 ]; then
            echo "  PASS: All services run as non-root"
        elif [ $user_count -ge 3 ]; then
            echo "  WARN: Some services run as root"
        else
            echo "  FAIL: Most services run as root"
        fi
        
        # Check for hardcoded secrets
        echo -e "\n[3] Secrets Management"
        if grep -rE "(password|secret|token|key).*=.*['\"][a-zA-Z0-9]{10,}" docker-compose.yml docker-compose.prod.yml 2>/dev/null | grep -v "POSTGRES_PASSWORD" | grep -v "_PASSWORD=\${" >/dev/null; then
            echo "  FAIL: Potential hardcoded secrets found"
        else
            echo "  PASS: No hardcoded secrets in compose files"
        fi
        
        if git ls-files | grep -E "\.env$" | grep -v ".env.example" >/dev/null 2>&1; then
            echo "  FAIL: .env files tracked in git"
        else
            echo "  PASS: No .env files in git"
        fi
        
        # Check for privileged containers
        echo -e "\n[4] Privileged Containers"
        if grep "privileged: true" docker-compose.yml docker-compose.prod.yml 2>/dev/null; then
            echo "  FAIL: Privileged containers detected"
        else
            echo "  PASS: No privileged containers"
        fi
        
        # Check image tags
        echo -e "\n[5] Image Tags"
        if grep -E "image:.*:latest" docker-compose.yml docker-compose.prod.yml 2>/dev/null; then
            echo "  WARN: Using latest tag (not recommended)"
        else
            echo "  PASS: Specific image versions used"
        fi
        
        # Check network isolation
        echo -e "\n[6] Network Isolation"
        local networks=$(grep -c "networks:" docker-compose.yml 2>/dev/null || echo 0)
        echo "  Networks configured: $networks"
        if [ "$networks" -ge 3 ]; then
            echo "  PASS: Network isolation implemented"
        else
            echo "  INFO: Limited network isolation"
        fi
        
    } > "$report_dir/custom-security-checks.txt"
    
    echo -e "\n${GREEN}✓ All tests completed for branch: $branch${NC}"
}

# ============================================================================
# KALKULACJA WYNIKÓW
# ============================================================================

calculate_final_score() {
    local report_dir=$1
    local total_score=0
    local test_count=0
    
    echo -e "\n${BLUE}Calculating scores for: $(basename $report_dir)${NC}"
    
    # CIS Docker Benchmark Score (40% wagi)
    if [ -f "$report_dir/cis-docker-benchmark.txt" ]; then
        local pass=$(grep -c "\[PASS\]" "$report_dir/cis-docker-benchmark.txt" 2>/dev/null || echo 0)
        local warn=$(grep -c "\[WARN\]" "$report_dir/cis-docker-benchmark.txt" 2>/dev/null || echo 0)
        local info=$(grep -c "\[INFO\]" "$report_dir/cis-docker-benchmark.txt" 2>/dev/null || echo 0)
        local total=$((pass + warn + info))
        local score=0
        [ $total -gt 0 ] && score=$((pass * 100 / total))
        echo "  CIS Docker Benchmark: $score/100 ($pass PASS, $warn WARN, $info INFO)"
        total_score=$((total_score + score * 4))  # 40% wagi
        test_count=$((test_count + 4))
    fi
    
    # OWASP ZAP Score (40% wagi)
    if [ -f "$report_dir/owasp-zap.txt" ]; then
        local high=$(grep -c "High \[" "$report_dir/owasp-zap.txt" 2>/dev/null || echo 0)
        local medium=$(grep -c "Medium \[" "$report_dir/owasp-zap.txt" 2>/dev/null || echo 0)
        local low=$(grep -c "Low \[" "$report_dir/owasp-zap.txt" 2>/dev/null || echo 0)
        
        # Score based on findings (base 100, odejmij punkty)
        local score=$((100 - (high * 15) - (medium * 5) - (low * 1)))
        [ $score -lt 0 ] && score=0
        
        echo "  OWASP ZAP: $score/100 ($high HIGH, $medium MEDIUM, $low LOW)"
        total_score=$((total_score + score * 4))  # 40% wagi
        test_count=$((test_count + 4))
    fi
    
    # Custom Security Checks Score (20% wagi)
    if [ -f "$report_dir/custom-security-checks.txt" ]; then
        local pass=$(grep -c "PASS:" "$report_dir/custom-security-checks.txt" 2>/dev/null || echo 0)
        local fail=$(grep -c "FAIL:" "$report_dir/custom-security-checks.txt" 2>/dev/null || echo 0)
        local warn=$(grep -c "WARN:" "$report_dir/custom-security-checks.txt" 2>/dev/null || echo 0)
        local total=$((pass + fail + warn))
        local score=0
        [ $total -gt 0 ] && score=$(( (pass * 100 + warn * 50) / total ))
        echo "  Custom Security: $score/100 ($pass PASS, $warn WARN, $fail FAIL)"
        total_score=$((total_score + score * 2))  # 20% wagi
        test_count=$((test_count + 2))
    fi
    
    # Calculate weighted average
    local final_score=0
    [ $test_count -gt 0 ] && final_score=$((total_score / test_count))
    
    echo $final_score
}

# ============================================================================
# GENEROWANIE RAPORTU KOŃCOWEGO
# ============================================================================

generate_final_report() {
    local main_score=$1
    local security_score=$2
    local improvement=$((security_score - main_score))
    local improvement_pct=0
    
    [ $main_score -gt 0 ] && improvement_pct=$((improvement * 100 / main_score))
    
    local report_file="$REPORT_DIR/FINAL_REPORT_$TIMESTAMP.md"
    
    cat > "$report_file" << EOF
# 🔒 Security Comparison Report

**Date:** $(date '+%Y-%m-%d %H:%M:%S')
**Project:** PrediGroweeV2
**Methodology:** CIS Docker Benchmark + OWASP ZAP + Custom Security Checks

---

## 📊 Executive Summary

| Branch | Overall Score | Grade | Status |
|--------|--------------|-------|--------|
| **main** (before fixes) | **${main_score}/100** | $(get_grade $main_score) | 🔴 Baseline |
| **security-fixes** (after fixes) | **${security_score}/100** | $(get_grade $security_score) | 🟢 Improved |

### 🎯 Overall Improvement: **+${improvement} points (+${improvement_pct}%)**

---

## 🔍 Detailed Test Results

### 1. CIS Docker Benchmark (40% weight)

**Testy zgodności z CIS Docker Benchmark v1.6.0**

#### main branch:
\`\`\`
PASS: $(grep "\[PASS\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
WARN: $(grep "\[WARN\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
INFO: $(grep "\[INFO\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
NOTE: $(grep "\[NOTE\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
\`\`\`

#### security-fixes branch:
\`\`\`
PASS: $(grep "\[PASS\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
WARN: $(grep "\[WARN\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
INFO: $(grep "\[INFO\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
NOTE: $(grep "\[NOTE\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l)
\`\`\`

**Delta:** +$(( $(grep "\[PASS\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) - $(grep "\[PASS\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) )) PASS

---

### 2. OWASP ZAP Baseline Scan (40% weight)

**Automatyczny test penetracyjny zgodny z OWASP Top 10**

#### main branch:
\`\`\`
HIGH:   $(grep -c "High \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
MEDIUM: $(grep -c "Medium \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
LOW:    $(grep -c "Low \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
\`\`\`

#### security-fixes branch:
\`\`\`
HIGH:   $(grep -c "High \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
MEDIUM: $(grep -c "Medium \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
LOW:    $(grep -c "Low \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) vulnerabilities
\`\`\`

**Delta:** -$(( $(grep -c "High \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) - $(grep -c "High \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) )) HIGH vulnerabilities fixed

---

### 3. Custom Security Configuration (20% weight)

**Dodatkowe sprawdzenia specyficzne dla projektu**

#### main branch:
\`\`\`
$(cat "$MAIN_DIR/custom-security-checks.txt" 2>/dev/null)
\`\`\`

#### security-fixes branch:
\`\`\`
$(cat "$SECURITY_DIR/custom-security-checks.txt" 2>/dev/null)
\`\`\`

---

## 📈 Improvement Breakdown

| Category | Before | After | Improvement |
|----------|--------|-------|-------------|
| CIS Docker Benchmark | $(grep "\[PASS\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) PASS | $(grep "\[PASS\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) PASS | +$(( $(grep "\[PASS\]" "$SECURITY_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) - $(grep "\[PASS\]" "$MAIN_DIR/cis-docker-benchmark.txt" 2>/dev/null | wc -l) )) |
| OWASP ZAP HIGH | $(grep -c "High \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) | $(grep -c "High \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) | -$(( $(grep -c "High \[" "$MAIN_DIR/owasp-zap.txt" 2>/dev/null || echo 0) - $(grep -c "High \[" "$SECURITY_DIR/owasp-zap.txt" 2>/dev/null || echo 0) )) |
| Security Hardening | $(grep -c "PASS:" "$MAIN_DIR/custom-security-checks.txt" 2>/dev/null || echo 0) | $(grep -c "PASS:" "$SECURITY_DIR/custom-security-checks.txt" 2>/dev/null || echo 0) | +$(( $(grep -c "PASS:" "$SECURITY_DIR/custom-security-checks.txt" 2>/dev/null || echo 0) - $(grep -c "PASS:" "$MAIN_DIR/custom-security-checks.txt" 2>/dev/null || echo 0) )) |

---

## 💡 Key Security Improvements

$(generate_recommendations $main_score $security_score)

---

## 📁 Raw Report Files

- **Main branch (before):** \`$MAIN_DIR/\`
  - CIS Docker Benchmark: \`cis-docker-benchmark.txt\`
  - OWASP ZAP: \`owasp-zap.txt\` + HTML/JSON reports
  - Custom checks: \`custom-security-checks.txt\`

- **Security-fixes branch (after):** \`$SECURITY_DIR/\`
  - CIS Docker Benchmark: \`cis-docker-benchmark.txt\`
  - OWASP ZAP: \`owasp-zap.txt\` + HTML/JSON reports
  - Custom checks: \`custom-security-checks.txt\`

---

## 🔧 Tools Used

1. **Docker Bench Security** - Automated CIS Docker Benchmark testing
   - https://github.com/docker/docker-bench-security
   - Tests: Host, Docker daemon, images, containers, security operations

2. **OWASP ZAP** - Automated penetration testing
   - https://www.zaproxy.org/
   - Tests: OWASP Top 10 vulnerabilities, baseline security scan

3. **Custom Security Checks** - Project-specific configuration validation
   - Container hardening (cap_drop, read-only, security_opt)
   - Non-root user configuration
   - Secrets management
   - Network isolation

---

**Generated by:** Security Comparison Script v2.0
**Timestamp:** $TIMESTAMP
**Report format:** Markdown

EOF

    echo -e "\n${GREEN}✓ Final report generated: $report_file${NC}"
    cat "$report_file"
}

get_grade() {
    local score=$1
    if [ $score -ge 90 ]; then
        echo "A (Excellent)"
    elif [ $score -ge 80 ]; then
        echo "B (Good)"
    elif [ $score -ge 70 ]; then
        echo "C (Fair)"
    elif [ $score -ge 60 ]; then
        echo "D (Poor)"
    else
        echo "F (Fail)"
    fi
}

generate_recommendations() {
    local main_score=$1
    local security_score=$2
    local improvement=$((security_score - main_score))
    
    echo "### 🎯 Security Posture Assessment"
    echo ""
    
    if [ $security_score -ge 85 ]; then
        echo "✅ **EXCELLENT** - Production-ready security posture"
        echo "- CIS Docker Benchmark compliance achieved"
        echo "- OWASP vulnerabilities mitigated"
        echo "- Container hardening fully implemented"
    elif [ $security_score -ge 70 ]; then
        echo "🟡 **GOOD** - Significant improvements, minor issues remain"
        echo "- Most critical vulnerabilities addressed"
        echo "- Container hardening partially implemented"
        echo "- Recommended: Review remaining WARN items"
    elif [ $security_score -ge 50 ]; then
        echo "� **FAIR** - Basic security measures in place"
        echo "- Some vulnerabilities mitigated"
        echo "- Additional hardening recommended"
        echo "- Action: Address HIGH priority issues"
    else
        echo "🔴 **NEEDS IMPROVEMENT** - Critical issues present"
        echo "- Major security gaps identified"
        echo "- Immediate action required"
        echo "- Priority: Fix CRITICAL and HIGH findings"
    fi
    
    echo ""
    echo "### 🔧 Implemented Security Measures"
    echo ""
    echo "Based on comparison between main and security-fixes branches:"
    echo ""
    echo "1. **Container Hardening**"
    echo "   - Linux Capabilities restriction (cap_drop: ALL)"
    echo "   - Privilege escalation prevention (no-new-privileges)"
    echo "   - Read-only root filesystem with tmpfs"
    echo "   - Resource limits (CPU, memory)"
    echo ""
    echo "2. **User Security**"
    echo "   - All services run as non-root users"
    echo "   - Proper UID/GID configuration"
    echo "   - Nginx configured with nginx user"
    echo ""
    echo "3. **Network Security**"
    echo "   - Network isolation (frontend, backend, db networks)"
    echo "   - Minimal port exposure"
    echo "   - Internal service communication"
    echo ""
    echo "4. **Secrets Management**"
    echo "   - Environment variable based secrets"
    echo "   - No hardcoded credentials"
    echo "   - .env files excluded from git"
    echo ""
    echo "5. **Image Security**"
    echo "   - Specific version tags (no latest)"
    echo "   - Minimal base images (Alpine Linux)"
    echo "   - No privileged containers"
    
    if [ $improvement -gt 0 ]; then
        echo ""
        echo "### 📊 Improvement Impact: +${improvement} points"
        echo ""
        echo "The security-fixes branch demonstrates measurable improvement in:"
        echo "- CIS Docker Benchmark compliance"
        echo "- OWASP vulnerability mitigation"
        echo "- Container configuration hardening"
    fi
}

# ============================================================================
# MAIN EXECUTION
# ============================================================================

main() {
    echo -e "${BLUE}Starting security comparison...${NC}\n"
    
    # Test main branch
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  TESTING: main branch (BEFORE security fixes)${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    test_branch "main" "$MAIN_DIR"
    MAIN_SCORE=$(calculate_final_score "$MAIN_DIR")
    
    # Test security-fixes branch
    echo -e "\n${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}  TESTING: security-fixes branch (AFTER fixes)${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    test_branch "security-fixes" "$SECURITY_DIR"
    SECURITY_SCORE=$(calculate_final_score "$SECURITY_DIR")
    
    # Wróć do security-fixes branch
    git checkout security-fixes -q
    
    # Generate final report
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  FINAL RESULTS${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    generate_final_report "$MAIN_SCORE" "$SECURITY_SCORE"
    
    # Summary
    local improvement=$((SECURITY_SCORE - MAIN_SCORE))
    local improvement_pct=0
    [ $MAIN_SCORE -gt 0 ] && improvement_pct=$((improvement * 100 / MAIN_SCORE))
    
    echo -e "\n${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║                  COMPARISON COMPLETE                      ║${NC}"
    echo -e "${GREEN}╠═══════════════════════════════════════════════════════════╣${NC}"
    echo -e "${GREEN}║  main:           ${MAIN_SCORE}/100 ($(get_grade $MAIN_SCORE))${NC}"
    echo -e "${GREEN}║  security-fixes: ${SECURITY_SCORE}/100 ($(get_grade $SECURITY_SCORE))${NC}"
    echo -e "${GREEN}║  Improvement:    +${improvement} points (+${improvement_pct}%)${NC}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
    
    echo -e "\n${BLUE}Full reports available in: $REPORT_DIR${NC}"
}

# Run main function
main "$@"
